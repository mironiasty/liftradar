{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": ["assets/*.js", "assets/*.css", "scripts/*.mjs", "types/globals.d.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "globals": [
      "maplibregl",
      "mlcontour",
      "DATE_LOCALE",
      "LANG",
      "LIST_KEY",
      "MAP_FONT",
      "SKI_MIN_ZOOM",
      "STALE_DAYS",
      "STATUS_COLORS",
      "STATUS_LABELS",
      "addPistes",
      "baseMap",
      "capitalized",
      "countryName",
      "cssColor",
      "dangerName",
      "darkMode",
      "dash",
      "el",
      "firstLabel",
      "fnuggCredit",
      "fold",
      "geometryBounds",
      "historyPath",
      "hoverTip",
      "loadIndex",
      "loadSki",
      "pair",
      "reportTimes",
      "resortOnMap",
      "resortPage",
      "resortPath",
      "skiKey",
      "skiPoint",
      "statusKey",
      "t",
      "updatedText",
      "viennaTime",
      "DEMS",
      "SKI_URL",
      "tileOf"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUndeclaredVariables": "error"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["assets/common.js", "assets/ski.js", "assets/basemap.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["types/globals.d.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
