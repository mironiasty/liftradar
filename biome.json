{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "web/assets/*.js",
      "web/assets/*.css",
      "scripts/*.mjs",
      "worker/*.js",
      "types/globals.d.ts",
      "!!**/.claude"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "globals": [
      "maplibregl",
      "mlcontour",
      "DATE_LOCALE",
      "LANG",
      "LIST_KEY",
      "MAP_FONT",
      "SKI_DIFFICULTIES",
      "SKI_LIFT_TYPES",
      "SKI_MIN_ZOOM",
      "STALE_DAYS",
      "STATUS_COLORS",
      "STATUS_LABELS",
      "addPistes",
      "baseMap",
      "capitalized",
      "countryName",
      "closeOnOutside",
      "countryMenu",
      "cssColor",
      "dangerName",
      "darkMode",
      "dash",
      "el",
      "favoriteButton",
      "favorites",
      "firstLabel",
      "fnuggCredit",
      "fold",
      "geometryBounds",
      "historyPath",
      "weatherPath",
      "hoverTip",
      "liftEnds",
      "liftLoader",
      "loadIndex",
      "loadGroups",
      "loadSki",
      "onFavoritesChange",
      "pair",
      "reportTimes",
      "resortKey",
      "resortOnMap",
      "resortPage",
      "resortPath",
      "setResortAddress",
      "skiKey",
      "skiPoint",
      "sourceItem",
      "statusKey",
      "t",
      "updatedText",
      "viennaTime",
      "DEMS",
      "SKI_URL",
      "tileOf",
      "present",
      "chart",
      "niceMax",
      "memberSummary",
      "mainCountry",
      "orderedMembers",
      "backLink",
      "areaPage",
      "countryPagePath",
      "COUNTRY_SLUGS",
      "label",
      "meter",
      "mapItems",
      "mapItemsReady",
      "breakdown",
      "stations",
      "resortMap",
      "weatherCard"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUndeclaredVariables": "error"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/assets/common.js", "web/assets/countries.js", "web/assets/ski.js", "web/assets/basemap.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["types/globals.d.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
