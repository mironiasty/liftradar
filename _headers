# Response headers on Cloudflare.
# The data is read by other sites and devices too: allow it from any origin.
/json/*
  Access-Control-Allow-Origin: *
/history/*
  Access-Control-Allow-Origin: *
/schema/*
  Access-Control-Allow-Origin: *
/openapi.json
  Access-Control-Allow-Origin: *
/ski/*
  Access-Control-Allow-Origin: *
# Ski tiles change at most weekly, and the pages and apps add ?b=<build> from meta.json, which
# they check more often. (Rules that match the same path add up, so each path gets one Cache-Control.)
/ski/v1/10/*
  Cache-Control: public, max-age=604800
/ski/v1/resorts.geojson
  Cache-Control: public, max-age=604800
/ski/v1/meta.json
  Cache-Control: public, max-age=3600
# The pages' scripts and styles: their links carry ?v=<commit> (pages.yml, which fails on a link without it),
# so a new version has a new address. The rest of /assets/ (ski-style.json, the images) keeps the default.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
# The 3D engine: each version at its own address (/engine/<tag>/), never changed once released.
/engine/*
  Cache-Control: public, max-age=31536000, immutable
# The phone apps' https links (DEVELOPMENT.md "App links"): iOS reads this file as JSON, though it has no extension.
/.well-known/apple-app-site-association
  Content-Type: application/json
/.well-known/assetlinks.json
  Content-Type: application/json
