{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liftradar.eu/schema/resort.schema.json",
  "$defs": {
    "Avalanche": {
      "additionalProperties": false,
      "description": "The avalanche bulletin for the resort's warning region (micro-region).",
      "properties": {
        "region_id": {
          "pattern": "^[A-Z]{2}-(\\d{1,4}|[A-Z]{2})(-[A-Z0-9]+)*$",
          "title": "Region Id",
          "type": "string"
        },
        "region": {
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "danger_level": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Danger Level"
        },
        "danger": {
          "anyOf": [
            {
              "enum": [
                "low",
                "moderate",
                "considerable",
                "high",
                "very_high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Danger"
        },
        "ratings": {
          "items": {
            "$ref": "#/$defs/DangerRating"
          },
          "title": "Ratings",
          "type": "array"
        },
        "problems": {
          "items": {
            "pattern": "^[a-z_]+$",
            "type": "string"
          },
          "title": "Problems",
          "type": "array"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "region_id",
        "region",
        "danger_level",
        "danger",
        "ratings",
        "problems",
        "published_at",
        "valid_from",
        "valid_until"
      ],
      "title": "Avalanche",
      "type": "object"
    },
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "minimum": 0,
          "title": "Open",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "open",
        "total"
      ],
      "title": "Counts",
      "type": "object"
    },
    "DangerRating": {
      "additionalProperties": false,
      "description": "One rating of a bulletin, for part of the day and/or an elevation band.",
      "properties": {
        "level": {
          "enum": [
            "low",
            "moderate",
            "considerable",
            "high",
            "very_high",
            "no_snow",
            "no_rating"
          ],
          "title": "Level",
          "type": "string"
        },
        "lower_bound": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "const": "treeline",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Bound"
        },
        "upper_bound": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "const": "treeline",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound"
        },
        "period": {
          "default": "all_day",
          "enum": [
            "all_day",
            "earlier",
            "later"
          ],
          "title": "Period",
          "type": "string"
        }
      },
      "required": [
        "level",
        "lower_bound",
        "upper_bound",
        "period"
      ],
      "title": "DangerRating",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "description": "A point in the ski area (or its main village), for maps.",
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Location",
      "type": "object"
    },
    "SlopeCounts": {
      "additionalProperties": false,
      "description": "Slope counts plus kilometres, when the resort publishes every slope's length.\n\nCounts can be missing where only kilometres are published (SalzburgerLand).\nopen_km is rounded to 0.1 km and total_km up to a whole km, so the\nrounded open km never exceeds the rounded total.",
      "properties": {
        "open": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "open_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open Km"
        },
        "total_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Km"
        }
      },
      "required": [
        "open",
        "total",
        "open_km",
        "total_km"
      ],
      "title": "SlopeCounts",
      "type": "object"
    },
    "Snow": {
      "additionalProperties": false,
      "properties": {
        "mountain_cm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mountain Cm"
        },
        "valley_cm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valley Cm"
        },
        "fresh_cm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fresh Cm"
        },
        "last_snowfall": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Snowfall"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "stations": {
          "items": {
            "$ref": "#/$defs/Station"
          },
          "title": "Stations",
          "type": "array"
        }
      },
      "required": [
        "mountain_cm",
        "valley_cm",
        "fresh_cm",
        "last_snowfall",
        "condition",
        "stations"
      ],
      "title": "Snow",
      "type": "object"
    },
    "SourceDetails": {
      "additionalProperties": false,
      "description": "The pages a report was built from, by what they give.",
      "properties": {
        "conditions": {
          "description": "Pages with current values: status, lifts and slopes open, snow, avalanche danger.",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Conditions",
          "type": "array"
        },
        "resort_info": {
          "description": "Pages with the resort's fixed information only: the size of its ski area, slope lengths.",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Resort Info",
          "type": "array"
        }
      },
      "required": [
        "conditions",
        "resort_info"
      ],
      "title": "SourceDetails",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "A page a report was built from.",
      "properties": {
        "url": {
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        },
        "attribution_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the source asks for attribution: true if it does, false if it's known not to, null if not checked yet (treat it as true).",
          "title": "Attribution Required"
        }
      },
      "required": [
        "url",
        "attribution_required"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Station": {
      "additionalProperties": false,
      "description": "A snow measuring point published by the resort.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "elevation_m": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation M"
        },
        "depth_cm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Cm"
        },
        "fresh_cm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fresh Cm"
        },
        "temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature C"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        }
      },
      "required": [
        "name",
        "elevation_m",
        "depth_cm",
        "fresh_cm",
        "temperature_c",
        "condition"
      ],
      "title": "Station",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://liftradar.eu/schema/resort.schema.json",
      "default": "https://liftradar.eu/schema/resort.schema.json",
      "title": "$Schema",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9-]+$",
      "title": "Id",
      "type": "string"
    },
    "country": {
      "description": "ISO 3166-1 alpha-2 code, lowercase",
      "pattern": "^[a-z]{2}$",
      "title": "Country",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "region": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "State or canton, e.g. Tirol, Valais",
      "title": "Region"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Location"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "website": {
      "anyOf": [
        {
          "pattern": "^https?://\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The resort's official website",
      "title": "Website"
    },
    "status": {
      "enum": [
        "open",
        "closed",
        "no_report"
      ],
      "title": "Status",
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "status_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status From"
    },
    "snow": {
      "$ref": "#/$defs/Snow"
    },
    "lifts": {
      "anyOf": [
        {
          "$ref": "#/$defs/Counts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "slopes": {
      "anyOf": [
        {
          "$ref": "#/$defs/SlopeCounts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lifts_by_type": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Counts"
          },
          "propertyNames": {
            "enum": [
              "gondola",
              "cable_car",
              "chairlift",
              "drag_lift",
              "carpet",
              "funicular",
              "other"
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lifts By Type"
    },
    "slopes_by_difficulty": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/SlopeCounts"
          },
          "propertyNames": {
            "enum": [
              "easy",
              "intermediate",
              "difficult",
              "ski_route",
              "other"
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Slopes By Difficulty"
    },
    "lifts_updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lifts Updated At"
    },
    "avalanche": {
      "anyOf": [
        {
          "$ref": "#/$defs/Avalanche"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sources": {
      "deprecated": true,
      "description": "Deprecated: use `source_details`, which says which pages give current conditions and which only the resort's fixed information, and whether each asks for attribution.",
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "source_details": {
      "$ref": "#/$defs/SourceDetails"
    },
    "errors": {
      "deprecated": true,
      "description": "Deprecated, to be removed: what failed in this run. See the run logs in logs/ on the data branch.",
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "id",
    "country",
    "name",
    "region",
    "location",
    "website",
    "status",
    "fetched_at",
    "status_from",
    "snow",
    "lifts",
    "slopes",
    "lifts_by_type",
    "slopes_by_difficulty",
    "lifts_updated_at",
    "avalanche",
    "sources",
    "source_details"
  ],
  "title": "Snow conditions for one resort",
  "type": "object"
}
