{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liftradar.eu/schema/resort-details.schema.json",
  "$defs": {
    "DetailsLift": {
      "additionalProperties": false,
      "description": "One lift as the source lists it.",
      "properties": {
        "id": {
          "description": "The source's id, stable between runs; where the source has none, made from the name",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The lift's number on the resort's map, e.g. C30",
          "title": "Ref"
        },
        "name": {
          "description": "As the source writes it, often with a type prefix (10EUB, SL)",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "gondola",
            "cable_car",
            "chairlift",
            "drag_lift",
            "carpet",
            "funicular",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "preparation",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "length_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length M"
        },
        "map_length_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its length on the map: its OpenStreetMap lines (OpenSkiData, © OpenStreetMap contributors, ODbL), measured along the slope by liftradar's weekly ski tiles, where they're matched to it; a slope's covers only its segments drawn as lines. Resorts often give longer slope lengths than their map",
          "title": "Map Length M"
        },
        "capacity_per_hour": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Per Hour"
        },
        "bottom_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Elevation of the valley station",
          "title": "Bottom M"
        },
        "top_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Elevation of the mountain station",
          "title": "Top M"
        }
      },
      "required": [
        "id",
        "ref",
        "name",
        "type",
        "status",
        "length_m",
        "map_length_m",
        "capacity_per_hour",
        "bottom_m",
        "top_m"
      ],
      "title": "DetailsLift",
      "type": "object"
    },
    "DetailsSlope": {
      "additionalProperties": false,
      "description": "One slope or ski route as the source lists it.",
      "properties": {
        "id": {
          "description": "The source's id, stable between runs; where the source has none, made from the name",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The slope's number on the resort's map, e.g. 4c",
          "title": "Ref"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "easy",
            "intermediate",
            "difficult",
            "ski_route",
            "other"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "colour": {
          "anyOf": [
            {
              "enum": [
                "green",
                "blue",
                "red",
                "black",
                "yellow",
                "orange",
                "blue_red",
                "red_black",
                "black_blue",
                "yellow_red"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its colour as the source marks it, where the source gives one: green (very easy, in France, Spain, Andorra and the Nordic countries), yellow and orange (Swiss ski routes and fun slopes), and pairs for two-colour slopes; `difficulty` groups them",
          "title": "Colour"
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "preparation",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "length_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length M"
        },
        "map_length_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its length on the map: its OpenStreetMap lines (OpenSkiData, © OpenStreetMap contributors, ODbL), measured along the slope by liftradar's weekly ski tiles, where they're matched to it; a slope's covers only its segments drawn as lines. Resorts often give longer slope lengths than their map",
          "title": "Map Length M"
        }
      },
      "required": [
        "id",
        "ref",
        "name",
        "difficulty",
        "colour",
        "status",
        "length_m",
        "map_length_m"
      ],
      "title": "DetailsSlope",
      "type": "object"
    },
    "ResortEnd": {
      "additionalProperties": false,
      "description": "The lowest or highest point of a resort's lifts on the map.",
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "elevation_m": {
          "title": "Elevation M",
          "type": "integer"
        }
      },
      "required": [
        "lat",
        "lon",
        "elevation_m"
      ],
      "title": "ResortEnd",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Experimental: every lift and slope of one resort with its status, from its slope map or from the source\nthat lists them one by one, and the resort's bottom and top. `unknown` items are listed but left out of the\nresort file's counts. Every resort the ski tiles know has a file; `lifts` and `slopes` only those whose\nsources list them (the resort file's `details` points to those).",
  "properties": {
    "$schema": {
      "const": "https://liftradar.eu/schema/resort-details.schema.json",
      "default": "https://liftradar.eu/schema/resort-details.schema.json",
      "title": "$Schema",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9-]+$",
      "title": "Id",
      "type": "string"
    },
    "country": {
      "pattern": "^[a-z]{2}$",
      "title": "Country",
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the source last updated the statuses",
      "title": "Updated At"
    },
    "source": {
      "anyOf": [
        {
          "pattern": "^https?://\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The page listing the lifts and slopes; null without them",
      "title": "Source"
    },
    "lifts": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DetailsLift"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null when the resort's sources don't list them, or this run couldn't read them",
      "title": "Lifts"
    },
    "slopes": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DetailsSlope"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null as `lifts`",
      "title": "Slopes"
    },
    "bottom": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResortEnd"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The lowest point of the resort's lifts on the map: OpenSkiData's lines and elevations (© OpenStreetMap contributors, ODbL), from liftradar's weekly ski tiles. Null when the tiles have no lifts for the resort"
    },
    "top": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResortEnd"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The highest point of the resort's lifts on the map: OpenSkiData's lines and elevations (© OpenStreetMap contributors, ODbL), from liftradar's weekly ski tiles. Null when the tiles have no lifts for the resort"
    }
  },
  "required": [
    "$schema",
    "id",
    "country",
    "fetched_at",
    "updated_at",
    "source",
    "lifts",
    "slopes",
    "bottom",
    "top"
  ],
  "title": "Experimental: every lift and slope of one resort",
  "type": "object",
  "x-experimental": true
}
